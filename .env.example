# =====================================================================
# Atlas Investments — environment variables
#
# Copy to .env.local and fill in. NEVER commit .env.local.
# NEVER paste real keys into chat, issues or pull requests.
# =====================================================================

# ---------------------------------------------------------------------
# Public — compiled into the browser bundle. Safe to expose.
# Supabase dashboard → Project Settings → API
# ---------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. This key carries no privilege of its own:
# every query it makes is filtered by Row Level Security. It is meant to be
# public and appearing in the browser is expected.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where this deployment is reachable. Used to build the links in invitation
# and password-reset emails, so it must match the real origin exactly.
#   local:      http://localhost:3000
#   production: https://atlasinvestmentsibw.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Server-only — NEVER prefix these with NEXT_PUBLIC_.
# On Netlify, set them as ordinary environment variables (not "deploy
# contexts" you might later expose to the client build).
# ---------------------------------------------------------------------

# The "service_role" key. THIS KEY BYPASSES ALL ROW LEVEL SECURITY.
# Anyone holding it can read every client record in the database.
# Used only for admin user management and the scheduled fund refresh.
# If it is ever exposed, rotate it immediately in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required by the scheduled fund-refresh endpoint, so the job
# cannot be triggered by anyone who discovers the URL.
# Generate one with:  openssl rand -base64 32
FUND_REFRESH_SECRET=
